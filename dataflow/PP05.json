{
	"name": "PP05",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedTextstore",
						"type": "DatasetReference"
					},
					"name": "stores"
				},
				{
					"dataset": {
						"referenceName": "DelimitedTextsales",
						"type": "DatasetReference"
					},
					"name": "sales"
				},
				{
					"dataset": {
						"referenceName": "DelimitedTextproducts",
						"type": "DatasetReference"
					},
					"name": "products"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Parquet1Storage",
						"type": "DatasetReference"
					},
					"name": "sink",
					"rejectedDataLinkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					}
				},
				{
					"name": "sinksalesother"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn"
				},
				{
					"name": "joinsProductssales"
				},
				{
					"name": "joinproductsalesstore"
				},
				{
					"name": "select"
				},
				{
					"name": "surrogateKey"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate"
				},
				{
					"name": "sort1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          store_id as string,",
				"          store_name as string,",
				"          region as string,",
				"          manager as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> stores",
				"source(output(",
				"          sale_id as short,",
				"          sale_date as string,",
				"          store_id as string,",
				"          product_id as string,",
				"          qty as short,",
				"          unit_price as short,",
				"          payment_mode as string,",
				"          city as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sales",
				"source(output(",
				"          product_id as string,",
				"          product_name as string,",
				"          category as string,",
				"          brand as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> products",
				"sales derive(sales_amount = qty*unit_price,",
				"          month_sales = toString(toDate(sale_date),'yyyy-MM')) ~> derivedColumn",
				"derivedColumn, products join(sales@product_id == products@product_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinsProductssales",
				"joinsProductssales, stores join(sales@store_id == stores@store_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinproductsalesstore",
				"joinproductsalesstore select(mapColumn(",
				"          sale_id,",
				"          sale_date,",
				"          store_id = sales@store_id,",
				"          product_id = sales@product_id,",
				"          qty,",
				"          unit_price,",
				"          payment_mode,",
				"          city,",
				"          sales_amount,",
				"          month_sales,",
				"          product_id = products@product_id,",
				"          product_name,",
				"          category,",
				"          brand,",
				"          store_id = stores@store_id,",
				"          store_name,",
				"          region,",
				"          manager",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select",
				"select keyGenerate(output(sales_sk as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey",
				"surrogateKey split(sales_amount>=500,",
				"     disjoint: false) ~> split1@(highvalue, regularsales)",
				"split1@highvalue aggregate(groupBy(region,",
				"          category),",
				"     total_qty = sum(qty),",
				"          total_sales = sum(sales_amount)) ~> aggregate",
				"aggregate sort(desc(total_sales, true)) ~> sort1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink",
				"split1@regularsales sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinksalesother"
			]
		}
	}
}