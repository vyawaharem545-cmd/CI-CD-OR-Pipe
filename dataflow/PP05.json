{
	"name": "PP05",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedTextstore",
						"type": "DatasetReference"
					},
					"name": "stores"
				},
				{
					"dataset": {
						"referenceName": "DelimitedTextsales",
						"type": "DatasetReference"
					},
					"name": "sales"
				},
				{
					"dataset": {
						"referenceName": "DelimitedTextproducts",
						"type": "DatasetReference"
					},
					"name": "products"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn"
				},
				{
					"name": "joinsProductssales"
				},
				{
					"name": "joinproductsalesstore"
				}
			],
			"scriptLines": [
				"source(output(",
				"          store_id as string,",
				"          store_name as string,",
				"          region as string,",
				"          manager as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> stores",
				"source(output(",
				"          sale_id as short,",
				"          sale_date as string,",
				"          store_id as string,",
				"          product_id as string,",
				"          qty as short,",
				"          unit_price as short,",
				"          payment_mode as string,",
				"          city as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sales",
				"source(output(",
				"          product_id as string,",
				"          product_name as string,",
				"          category as string,",
				"          brand as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> products",
				"sales derive(sales_amount = qty*unit_price,",
				"          month_sales = toString(toDate(sale_date),'yyyy-MM')) ~> derivedColumn",
				"derivedColumn, products join(sales@product_id == products@product_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinsProductssales",
				"joinsProductssales, stores join(sales@store_id == stores@store_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinproductsalesstore"
			]
		}
	}
}